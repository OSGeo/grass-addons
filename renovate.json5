{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",

        // Use config file from upstream GRASS repo
        "github>OSGeo/grass:renovate.json5",
        "customManagers:biomeVersions",
    ],

    "packageRules": [
        {
            "groupName": "biome",
            "matchPackageNames": [
                "biomejs/pre-commit",
                "@biomejs/biome",
            ],
        },
    ],
}
