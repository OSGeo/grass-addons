{
    "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
    "formatter": {
        "useEditorconfig": true,
        "enabled": true
    },
    "linter": {
        "enabled": true
    },
    "assist": {
        "enabled": true
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
